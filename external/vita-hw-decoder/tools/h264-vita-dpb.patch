+// H.264 table A-1 MaxDpbMbs, indexed by level_idc.
+static int vita_h264_level_dpb_frames(int level_idc, int mbs)
+{
+    int max_dpb_mbs;
+    switch (level_idc) {
+    case 30: max_dpb_mbs = 8100;   break;
+    case 31: max_dpb_mbs = 18000;  break;
+    case 32: max_dpb_mbs = 20480;  break;
+    case 40:
+    case 41: max_dpb_mbs = 32768;  break;
+    case 42: max_dpb_mbs = 34816;  break;
+    case 50: max_dpb_mbs = 110400; break;
+    case 51:
+    case 52: max_dpb_mbs = 184320; break;
+    default: max_dpb_mbs = 8100;   break; // low/unknown levels: stay small
+    }
+    if (mbs <= 0)
+        return 1;
+    return FFMIN(FFMAX(max_dpb_mbs / mbs, 1), 16);
 }
 
